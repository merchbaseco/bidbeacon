node_modules/
dist/
.env
.env.local
.env.*.local
*.log
.DS_Store
src/health/deployed-revision.stamp.ts
coverage/
.nyc_output/
.context/
# Cursor links fleet skills into .agents/skills; the cloud agent scripts stay tracked.
.agents/*
!.agents/cloud/

# Agent-local state, including Claude worktrees. A checkout under
# .claude/worktrees/ carries its own biome.json, which the linter would
# otherwise walk into and fail on. Committed agent definitions stay tracked.
.claude/*
!.claude/agents/
!.claude/settings.json
!.claude/skills/

# Varlock schema is the committed contract
!.env.schema
