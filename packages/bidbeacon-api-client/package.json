{
  "name": "@bidbeacon/http-client",
  "version": "3.2.0",
  "description": "Typed tRPC client for BidBeacon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merchbaseco/bidbeacon.git",
    "directory": "packages/bidbeacon-api-client"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@trpc/client": "11.8.1",
    "@trpc/server": "11.8.1"
  }
}
