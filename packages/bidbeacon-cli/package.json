{
  "name": "@bidbeacon/cli",
  "version": "3.1.0",
  "description": "BidBeacon CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bb": "dist/index.js"
  },
  "scripts": {
    "build:changelog": "cp ../../CHANGELOG.md CHANGELOG.md",
    "build": "bun run build:changelog && rm -rf dist && bun build ../../packages/bidbeacon-cli/src/index.ts --target=node --format=esm --packages=external --outfile dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@bidbeacon/http-client": "3.1.0",
    "@merchbaseco/access": "0.3.0"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ]
}
