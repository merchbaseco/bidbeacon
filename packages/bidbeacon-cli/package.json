{
  "name": "@bidbeacon/cli",
  "version": "0.2.3",
  "description": "BidBeacon CLI",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "bb": "dist/index.js"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --external @bidbeacon/http-client --outfile dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@bidbeacon/http-client": "^0.2.3"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
