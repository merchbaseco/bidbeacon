{
  "name": "@bidbeacon/server",
  "private": true,
  "version": "2.0.1",
  "description": "Docker-deployable API service for BidBeacon",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "vite build && bun run skill:package",
    "build:dashboard": "vite build --config vite.config.dashboard.ts",
    "start": "dotenv --no-expand -e .env -- node dist/index.js",
    "start:worker": "dotenv --no-expand -e .env -- node dist/worker.js",
    "dev:server": "sh -c 'export DISABLE_SERVER_JOB_RUNNER=\"${DISABLE_SERVER_JOB_RUNNER:-true}\"; exec dotenv --no-expand -e .env -- tsx src/index.ts'",
    "dev": "concurrently -k -n server,dashboard -c cyan,magenta \"bun run dev:server\" \"DASHBOARD_API_PROXY_TARGET=http://localhost:8080 VITE_API_BASE_URL=http://localhost:8080 bun run dev:dashboard\"",
    "dev:dashboard": "vite dev --config vite.config.dashboard.ts",
    "preview:dashboard": "vite preview --config vite.config.dashboard.ts",
    "bb": "bun packages/bidbeacon-cli/src/index.ts",
    "access:plan": "tsx scripts/plan-access-cutover.ts",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "worker": "dotenv --no-expand -e .env -- tsx src/worker/index.ts",
    "peek-dlq": "tsx scripts/peek-dlq.ts",
    "skill:package": "bun scripts/package-account-management-skill.ts",
    "skill:validate": "bun scripts/validate-account-management-skill.ts",
    "prepublishOnly": "node -e \"console.error('Root package publish is blocked. Publish from packages/bidbeacon-api-client or packages/bidbeacon-cli instead.'); process.exit(1)\"",
    "test": "vitest",
    "version:check": "tsx scripts/verify-release-versions.ts",
    "api-client:types": "dts-bundle-generator --no-check -o packages/bidbeacon-api-client/src/app-router.d.ts src/api/router-public.ts --project tsconfig.api-client.json",
    "api-client:build": "bun run api-client:types && tsc -p packages/bidbeacon-api-client/tsconfig.json && cp packages/bidbeacon-api-client/src/app-router.d.ts packages/bidbeacon-api-client/dist/app-router.d.ts",
    "cli:build": "cd packages/bidbeacon-cli && bun run build",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "3.971.0",
    "@aws-sdk/client-sqs": "3.971.0",
    "@bidbeacon/http-client": "2.0.1",
    "@clerk/backend": "2.33.3",
    "@clerk/clerk-react": "5.61.6",
    "@clerk/mcp-tools": "0.6.0",
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/websocket": "11.2.0",
    "@merchbaseco/access": "0.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@rankwrangler/http-client": "0.9.0",
    "@trpc/client": "11.8.1",
    "@trpc/react-query": "11.8.1",
    "@trpc/server": "11.8.1",
    "bottleneck": "2.19.5",
    "csv-parse": "6.1.0",
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "lodash-es": "4.18.1",
    "pg-boss": "12.5.2",
    "postgres": "3.4.8",
    "tslib": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@biomejs/biome": "2.3.13",
    "@electric-sql/pglite": "0.5.4",
    "@fontsource/aclonica": "5.2.8",
    "@fontsource/geist-mono": "5.2.7",
    "@hugeicons-pro/core-solid-rounded": "4.1.0",
    "@hugeicons-pro/core-stroke-rounded": "4.0.0",
    "@hugeicons/react": "1.1.5",
    "@mui/base": "5.0.0-beta.70",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/react-query": "5.90.19",
    "@types/lodash-es": "4.17.12",
    "@types/node": "24.10.9",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.1.2",
    "autoprefixer": "10.4.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "8.2.2",
    "csstype": "3.2.3",
    "dotenv-cli": "10.0.0",
    "drizzle-kit": "0.31.10",
    "dts-bundle-generator": "9.5.1",
    "jotai": "2.16.2",
    "lucide-react": "0.560.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.12.0",
    "react-use-websocket": "4.13.0",
    "recharts": "3.6.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "ultracite": "7.1.5",
    "vite": "7.3.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "ajv": "8.20.0",
    "esbuild": "0.27.3",
    "fast-uri": "3.1.2",
    "fast-xml-parser": "5.8.0",
    "lodash": "4.18.1",
    "minimatch": "10.2.5",
    "picomatch": "4.0.4",
    "postcss": "8.5.14",
    "rollup": "4.60.4",
    "vite": "7.3.3",
    "ws": "8.20.1"
  },
  "packageManager": "bun@1.3.5"
}
