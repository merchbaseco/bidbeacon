# GitHub Packages token (for @merchbaseco/access package)
MERCHBASE_GITHUB_NPM_TOKEN=your_github_pat_with_read_packages_scope

# npmjs publish token (for @merchbase/bidbeacon-http-client)
NPM_TOKEN=your_npm_granular_token_with_publish_access

# Shared Merchbase authentication
MERCHBASE_API_KEY=your_merchbase_api_key_here

# RankWrangler title enrichment for BidBeacon Search
RANKWRANGLER_BASE_URL=https://rankwrangler.merchbase.co

# Clerk server verification and signed access webhooks
CLERK_ISSUER=https://clerk.merchbase.co
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_JWT_KEY=your_clerk_jwt_public_key_here
CLERK_WEBHOOK_SIGNING_SECRET=your_clerk_webhook_signing_secret_here
CLERK_AUTHORIZED_PARTIES=https://bidbeacon.merchbase.co,http://localhost:4173,http://localhost:4174

# Remote MCP resource identifier used in OAuth metadata
MCP_RESOURCE_URL=https://bidbeacon.merchbase.co/mcp

# CLI non-secret defaults and shared API-key override
BB_STORAGE_DIR=~/.bidbeacon
BB_BASE_URL=http://localhost:8080
BB_ACCOUNT_ID=your_ads_account_id_here
BB_COUNTRY_CODE=US

# Database
BIDBEACON_DATABASE_PASSWORD=your_secure_password_here
BIDBEACON_DATABASE_HOST=postgres
BIDBEACON_DATABASE_PORT=5432
BIDBEACON_DATABASE_NAME=bidbeacon
BIDBEACON_DATABASE_USER=bidbeacon

# Amazon Ads API Configuration
ADS_API_REFRESH_TOKEN=your_ads_api_refresh_token_here
ADS_API_CLIENT_ID=your_ads_api_client_id_here
ADS_API_CLIENT_SECRET=your_ads_api_client_secret_here
ADS_API_TEST_ACCOUNT_ID=your_ads_api_test_account_id_here
ADS_API_TEST_ASIN=your_ads_api_test_asin_here

# AWS Configuration (for SQS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AMS_QUEUE_URL=your_sqs_queue_url_here

# Server runtime toggles
# Set to true to prevent the API server process from starting PgBoss jobs.
# Local dev scripts default this to true unless you override it.
DISABLE_SERVER_JOB_RUNNER=false

# Notes:
# - Copy this file to .env and fill in your values
# - Escape $ characters as $$ in docker-compose (e.g., password hashes)

# Dashboard dev proxy (optional)
# DASHBOARD_API_PROXY_TARGET=http://localhost:8080
