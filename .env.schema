# The plugin version is pinned so the schema resolves through `bunx varlock`
# before node_modules exists (cloud-agent and fresh-clone installs).
# @plugin(@varlock/1password-plugin@2.0.3)
# @initOp(id=development, token=fallback($CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN, $CI_OP_TOKEN), allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @initOp(id=production, token=$DEPLOY_AGENT_PRODUCTION_OP_TOKEN, allowAppAuth=false)
# @initOp(id=release, token=$RELEASE_AGENT_TOOLING_OP_TOKEN, allowAppAuth=forEnv(development), account=knickerbockerventures.1password.com)
# @currentEnv=$VARLOCK_ENV
# Lifecycles: production and development resolve through 1Password; test
# resolves to fake-but-shaped literals only, so schema validation and the
# Vitest suites run fully offline with no 1Password access. Every lifecycle
# resolves deliberately — add a test arm whenever you add a variable.
# Sensitivity fails safe: an item without an explicit marker resolves as
# sensitive, so a forgotten decorator becomes a container secret rather than a
# plaintext value baked into the dashboard bundle. Public values must opt out
# explicitly.
# @defaultSensitive=true @defaultRequired=infer
# ---

# Varlock's selector. The enum is the fail-loud guard: any other value —
# including lifecycles varlock can infer in CI, like preview — is rejected at
# load instead of silently riding each value's development arm.
# @public @auditIgnore @type=enum(development, production, test)
VARLOCK_ENV=development


# --- Bootstrap identities ------------------------------------------------
# One per unattended consumer; the name encodes the consumer and lifecycle it
# serves. Supervised local work uses 1Password desktop-app authorization
# instead. Both are @internal, so `varlock run` never exports them into the
# server container or the dashboard build.

# Production deploy-agent role slot: each deploy venue supplies its own
# identity under this one name — the self-hosted GitHub Actions runner on the
# Mac mini injects the GitHub deploy agent's token
# (GH_DEPLOY_AGENT_PRODUCTION_OP_TOKEN secret), and an operator run resolves
# the Mac Mini identity through `op run` in the deploy script.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @required=forEnv(production)
DEPLOY_AGENT_PRODUCTION_OP_TOKEN=

# Shared cloud-agent development identity, read-only on the Development vault:
# a Cursor account-scoped Runtime Secret and an environment variable on the
# Claude cloud environment. Supervised local development leaves this empty and
# uses desktop-app authorization.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CLOUD_AGENTS_DEVELOPMENT_OP_TOKEN=

# CI bootstrap role slot. Quality and the deploy command supply the GitHub
# deploy identity here to resolve install credentials from the Development vault.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
CI_OP_TOKEN=

# Release-agent role slot, read-only on the Tooling vault. The Deploy Stack
# publish job injects GH_RELEASE_AGENT_TOOLING_OP_TOKEN. A local release leaves
# this empty and uses desktop-app authorization on the release client.
# @type=opServiceAccountToken @sensitive @internal @auditIgnore
# @optional
RELEASE_AGENT_TOOLING_OP_TOKEN=


# --- Context switches ----------------------------------------------------
# Machinery credentials resolve ONLY behind these switches. Build, dev-server,
# test, and ordinary production resolution therefore never contact 1Password —
# which matters because Vite and the Docker build re-resolve the whole schema
# in contexts that cannot authenticate.

# Set to true by the install script when fetching install tokens with
# `varlock printenv`.
# @public @internal @auditIgnore @type=boolean
BIDBEACON_RESOLVE_INSTALL_TOKENS=false

# Set to true by the npm release flow when fetching the publish token. Release
# is a separate context from install: it targets the Tooling vault through the
# release client. The Deploy Stack publish job and a local release both set it.
# @public @internal @auditIgnore @type=boolean
BIDBEACON_RESOLVE_RELEASE_TOKENS=false


# --- Machinery credentials -----------------------------------------------

# Installing the private @merchbaseco/* packages. Shared suite credential: the
# name identifies the issuing owner, not this repo, and it resolves from the
# existing shared item rather than a per-repo copy. Referenced literally by
# .npmrc. CI and the deploy runner inject their own platform copy (the
# workflow's repository-scoped github.token), which wins as process env.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_GITHUB_NPM_TOKEN=if(eq($BIDBEACON_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/GitHub Packages Read - Merchbase/credential"), "")

# Licensed @hugeicons-pro dist downloads. Shared suite credential — the same
# vendor licence serves BidBeacon, MerchBase Core, Handmade, TMTerminal, and
# PunchPress — so it resolves from one shared item under the owner prefix.
# Referenced literally by bunfig.toml's [install.scopes] token.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_HUGEICONS_LICENSE_KEY=if(eq($BIDBEACON_RESOLVE_INSTALL_TOKENS, true), op(development, "op://Development/HugeIcons Pro - Merchbase/credential"), "")

# Publishing @bidbeacon/cli and @bidbeacon/http-client to the public npm
# registry. Shared suite credential — one publish token for every Merchbase
# package — gated by this repo's release switch because only a BidBeacon
# release run needs it. Resolved through the release client, which reads the
# Tooling vault. Referenced literally by .npmrc.
# @sensitive @internal @auditIgnore @optional
MERCHBASE_NPM_PUBLISH_TOKEN=if(eq($BIDBEACON_RESOLVE_RELEASE_TOKENS, true), op(release, "op://Tooling/NPM Publish - Merchbase/credential"), "")


# --- Cloudflare Access ---------------------------------------------------
# Production origin assertions use distinct interactive, API and internal audiences.
# Development is offline and refuses non-local database targets.

# @public @required=forEnv(production)
MERCHBASE_ACCESS_ISSUER=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/issuer"), if(eq($VARLOCK_ENV, test), https://merchbase-test.cloudflareaccess.com, ""))

# @public @required=forEnv(production)
MERCHBASE_ACCESS_AUTHORITY_ORIGIN=if(eq($VARLOCK_ENV, production), https://access-internal.merchbase.co, if(eq($VARLOCK_ENV, test), https://access-internal.test, ""))

# @public @required=forEnv(production)
MERCHBASE_ACCESS_API_AUDIENCE=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/API audience"), if(eq($VARLOCK_ENV, test), test-merchbase_access_api_audience, ""))

# @public @required=forEnv(production)
MERCHBASE_ACCESS_INTERACTIVE_AUDIENCE=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/interactive audience"), if(eq($VARLOCK_ENV, test), test-merchbase_access_interactive_audience, ""))

# @public @required=forEnv(production)
MERCHBASE_ACCESS_BIDBEACON_INTERNAL_AUDIENCE=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Access - Merchbase/BidBeacon internal audience"), if(eq($VARLOCK_ENV, test), test-merchbase_access_bidbeacon_internal_audience, ""))

# @public @required=forEnv(production)
MERCHBASE_ACCESS_AUTHORITY_CLIENT_ID=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - Merchbase Access/client id"), if(eq($VARLOCK_ENV, test), test-merchbase_access_authority_client_id, ""))

# @sensitive @required=forEnv(production)
MERCHBASE_ACCESS_BIDBEACON_CLIENT_ID=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - BidBeacon/client id"), if(eq($VARLOCK_ENV, test), test-merchbase_access_bidbeacon_client_id, ""))

# @sensitive @required=forEnv(production)
MERCHBASE_ACCESS_BIDBEACON_CLIENT_SECRET=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Cloudflare Service - BidBeacon/client secret"), if(eq($VARLOCK_ENV, test), test-merchbase_access_bidbeacon_client_secret, ""))


# --- Server runtime configuration ----------------------------------------

# @public @type=port
BIDBEACON_PORT=8080

# Compose resolves the database over the container network. Host-run
# development uses a local database; authentication refuses remote targets.
# Production uses the Compose service hostname.
# @public
BIDBEACON_DATABASE_HOST=if(eq($VARLOCK_ENV, production), postgres, localhost)

# @public @type=port
BIDBEACON_DATABASE_PORT=5432

# @public
BIDBEACON_DATABASE_NAME=bidbeacon

# @public
BIDBEACON_DATABASE_USER=bidbeacon

# @sensitive @required
BIDBEACON_DATABASE_PASSWORD=if(eq($VARLOCK_ENV, test), bidbeacon, if(eq($VARLOCK_ENV, production), op(production, "op://Production/Postgres - BidBeacon/password"), op(development, "op://Development/Postgres - BidBeacon/password")))

# Local server scripts disable the background job runner by default; the
# production stack runs jobs in the dedicated worker container.
# @public @type=boolean
BIDBEACON_DISABLE_SERVER_JOB_RUNNER=if(eq($VARLOCK_ENV, production), false, true)

# Resource fallback used for loopback MCP metadata in development. Hosted
# discovery derives the resource from the admitted request hostname.
# Must be an absolute http(s) URL whose path is exactly /mcp.
# @public @type=url
BIDBEACON_MCP_RESOURCE_URL=https://bidbeacon-api.merchbase.co/mcp

# RankWrangler product-title enrichment for BidBeacon Search. Read by the API
# server only; the worker does not resolve product titles.
# @public @type=url
BIDBEACON_RANKWRANGLER_BASE_URL=if(eq($VARLOCK_ENV, test), https://rankwrangler.test, https://rankwrangler-internal.merchbase.co)

# Optional HMAC key for search keyset cursors. Unset, the server generates a
# per-process random key, so cursors stop verifying across a restart. Not
# provisioned today; give it a Production item if cursors ever need to survive
# a redeploy or span more than one server replica.
# @sensitive @optional
BIDBEACON_SEARCH_CURSOR_SECRET=if(eq($VARLOCK_ENV, test), test-cursor-secret, undefined)


# --- Amazon Ads API (BidBeacon-owned) ------------------------------------
# One Amazon Ads application authorisation serves both lifecycles: the refresh
# token is bound to the authorising Amazon account, so the provider issues a
# single credential. Stored in both lifecycle vaults with a cross-reference in
# each note; rotate both together.

# `amazon` calls the live Ads API. `fake` records create, update, and delete
# calls locally and never opens a connection. The server refuses `fake` when
# NODE_ENV or VARLOCK_ENV is production. Containers do not receive this item.
# @public
BIDBEACON_AMAZON_ADS_GATEWAY=amazon

# Production always resolves the vault item, even if the fake selector is set.
# A non-production fake run uses a placeholder so boot does not need the vault.
# @sensitive @required
BIDBEACON_ADS_API_CLIENT_ID=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Amazon Ads API - BidBeacon/username"), if(eq($BIDBEACON_AMAZON_ADS_GATEWAY, fake), local-fake-not-a-credential, if(eq($VARLOCK_ENV, test), amzn1.application-oa2-client.test, op(development, "op://Development/Amazon Ads API - BidBeacon/username"))))

# @sensitive @required
BIDBEACON_ADS_API_CLIENT_SECRET=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Amazon Ads API - BidBeacon/credential"), if(eq($BIDBEACON_AMAZON_ADS_GATEWAY, fake), local-fake-not-a-credential, if(eq($VARLOCK_ENV, test), amzn1-test-client-secret, op(development, "op://Development/Amazon Ads API - BidBeacon/credential"))))

# @sensitive @required
BIDBEACON_ADS_API_REFRESH_TOKEN=if(eq($VARLOCK_ENV, production), op(production, "op://Production/Amazon Ads API - BidBeacon/refresh token"), if(eq($BIDBEACON_AMAZON_ADS_GATEWAY, fake), local-fake-not-a-credential, if(eq($VARLOCK_ENV, test), Atzr-test-refresh-token, op(development, "op://Development/Amazon Ads API - BidBeacon/refresh token"))))


# --- AWS SQS (BidBeacon-owned) -------------------------------------------
# The Amazon Marketing Stream queue and the IAM user that reads it. One IAM
# access key serves both lifecycles today; stored in both vaults with a
# cross-reference until a separate development key is issued in the AWS
# console.

# @public
BIDBEACON_AWS_REGION=us-east-1

# @sensitive @required
BIDBEACON_AWS_ACCESS_KEY_ID=if(eq($VARLOCK_ENV, test), AKIATEST000000000000, if(eq($VARLOCK_ENV, production), op(production, "op://Production/AWS Marketing Stream - BidBeacon/username"), op(development, "op://Development/AWS Marketing Stream - BidBeacon/username")))

# @sensitive @required
BIDBEACON_AWS_SECRET_ACCESS_KEY=if(eq($VARLOCK_ENV, test), aws-test-secret-access-key, if(eq($VARLOCK_ENV, production), op(production, "op://Production/AWS Marketing Stream - BidBeacon/credential"), op(development, "op://Development/AWS Marketing Stream - BidBeacon/credential")))

# The queue URL embeds the AWS account id, so it is treated as sensitive and
# lives with the credential that reads it.
# @sensitive @required
BIDBEACON_AMS_QUEUE_URL=if(eq($VARLOCK_ENV, test), https://sqs.us-east-1.amazonaws.com/000000000000/bidbeacon-test, if(eq($VARLOCK_ENV, production), op(production, "op://Production/AWS Marketing Stream - BidBeacon/queue url"), op(development, "op://Development/AWS Marketing Stream - BidBeacon/queue url")))


# --- Dashboard build inputs ----------------------------------------------
# External literal-prefix exemption: Vite only exposes variables whose name
# begins with VITE_, so the prefix is a platform requirement. The owner prefix
# follows it, keeping one canonical owner per value. Everything here is inlined
# into a public browser bundle at build time and must therefore be @public —
# never place a secret behind a VITE_ name.

# Same-origin /api when empty; set only when the dashboard dev server talks to
# a server on another origin.
# @public @optional
VITE_BIDBEACON_API_URL=

# Vite dev-server proxy target for /api. Development only; empty means the
# dev server proxies to the production origin.
# @public @type=url
BIDBEACON_DASHBOARD_API_PROXY_TARGET=http://localhost:8080

# Bind address for the dashboard dev server, and a development-only concern:
# `vite.config.dashboard.ts` is the only reader and nothing in the server or
# worker runtime touches it. Loopback keeps a dev server — and the synthetic
# seed data behind it — off the network. An environment that reaches the server
# through a port forwarder sets 0.0.0.0, because such forwarders find a
# session's ports by watching for listening sockets and a loopback-only bind is
# invisible to them; Cursor's `dev` terminal is where that knowledge lives, so app
# code stays vendor-neutral.
#
# Deliberately public rather than internal-only. Varlock strips internal-marked
# items from the environment it hands a `varlock run` child, even when the
# parent shell exported one, so an internal-marked knob could never reach the
# dev server it is supposed to configure.
# @public @auditIgnore @type=ip
BIDBEACON_DEV_HOST=127.0.0.1


# --- Live smoke test switches --------------------------------------------
# Operator-supplied and never provisioned: the live CLI smoke test is opt-in
# and talks to a real account. The suite skips entirely when the switch is off.

# @public @type=boolean
BIDBEACON_RUN_LIVE_SMOKE=false

# @public @optional
BIDBEACON_LIVE_ACCOUNT_ID=

# @public @optional
BIDBEACON_LIVE_ASIN=
