# Local dev defaults for the Cloud Agent environment.
# install.sh copies this to .env only when .env is absent, so real secrets
# injected via the Secrets panel (same variable names) always take precedence.

# Local Postgres started by .cursor/start.sh
BIDBEACON_DATABASE_HOST=127.0.0.1
BIDBEACON_DATABASE_PORT=5432
BIDBEACON_DATABASE_NAME=bidbeacon
BIDBEACON_DATABASE_USER=bidbeacon
BIDBEACON_DATABASE_PASSWORD=bidbeacon

# Do not start PgBoss job runners in local app-server sessions.
DISABLE_SERVER_JOB_RUNNER=true

# Dashboard talks to the local API instead of production.
DASHBOARD_API_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Clerk config. Issuer/publishable are public; the secret/webhook values below
# are non-empty placeholders so the server boots for unauthenticated flows
# (health, migrations). Replace via the Secrets panel to exercise authed routes.
CLERK_ISSUER=https://clerk.merchbase.co
CLERK_AUTHORIZED_PARTIES=http://localhost:4173,http://localhost:4174
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_JWT_KEY=placeholder
CLERK_WEBHOOK_SIGNING_SECRET=whsec_placeholder
VITE_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
